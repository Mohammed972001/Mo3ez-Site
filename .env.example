# Search-console ownership verification (spec 002).
# Set these in Vercel → Project → Settings → Environment Variables, then redeploy.
# Values are the token ONLY (not the full meta tag).
#
# Google Search Console → Add property (URL prefix: https://moket-elsuarye.com)
#   → Verify via "HTML tag" → copy the content="..." value:
NEXT_PUBLIC_GSC_VERIFICATION=
#
# Bing Webmaster Tools → Add site → Verify via "Meta tag" (msvalidate.01):
NEXT_PUBLIC_BING_VERIFICATION=

# Review submissions (spec 003). Optional: POST target for moderation
# (Zapier / Make / Google Apps Script / n8n / mail relay). When unset,
# submissions are still recorded in the Vercel server logs.
REVIEW_WEBHOOK_URL=
